# Supabase connection — safe to expose publicly, this is the "publishable"
# (anon) key, not the secret service-role key. Get these from your Supabase
# project: Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
